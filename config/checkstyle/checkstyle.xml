<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  A deliberately small ruleset. Formatting is Spotless's job, so nothing here
  duplicates it. These rules catch defects and the habits that hide defects.
-->
<module name="Checker">
  <property name="severity" value="error"/>
  <property name="fileExtensions" value="java"/>

  <module name="SuppressionFilter">
    <property name="file" value="${config_loc}/suppressions.xml"/>
  </module>

  <module name="NewlineAtEndOfFile"/>
  <module name="FileTabCharacter"/>
  <module name="LineLength">
    <property name="max" value="140"/>
    <property name="ignorePattern" value="^package.*|^import.*|^\s*//.*https?://"/>
  </module>

  <module name="TreeWalker">

    <!-- Imports: unused or wildcard imports hide what a class really depends on. -->
    <module name="UnusedImports"/>
    <module name="RedundantImport"/>
    <module name="AvoidStarImport"/>
    <module name="IllegalImport"/>

    <!-- Correctness. -->
    <module name="EqualsHashCode"/>
    <module name="CovariantEquals"/>
    <module name="StringLiteralEquality"/>
    <module name="NoClone"/>
    <module name="NoFinalizer"/>
    <module name="SimplifyBooleanExpression"/>
    <module name="SimplifyBooleanReturn"/>
    <module name="FallThrough"/>
    <module name="MissingSwitchDefault"/>
    <module name="DefaultComesLast"/>
    <module name="EmptyStatement"/>
    <module name="EqualsAvoidNull"/>
    <module name="OneStatementPerLine"/>
    <module name="UnnecessarySemicolonInEnumeration"/>
    <module name="UnnecessarySemicolonAfterTypeMemberDeclaration"/>

    <!-- An empty catch block is how a bug becomes invisible. -->
    <module name="EmptyCatchBlock">
      <property name="exceptionVariableName" value="expected|ignored"/>
    </module>
    <module name="IllegalCatch">
      <property name="illegalClassNames" value="java.lang.Throwable,java.lang.Error"/>
    </module>
    <module name="IllegalThrows"/>

    <!-- Braces: always required, so adding a line cannot change control flow. -->
    <module name="NeedBraces"/>
    <module name="LeftCurly"/>
    <module name="RightCurly"/>

    <!-- Naming. -->
    <module name="PackageName">
      <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
    </module>
    <module name="TypeName"/>
    <module name="MethodName"/>
    <module name="ParameterName"/>
    <module name="LocalVariableName"/>
    <module name="MemberName"/>
    <module name="StaticVariableName"/>
    <!--
      Constants are SCREAMING_SNAKE_CASE, with one allowance: a static final Logger named
      "log". That spelling is near-universal in Java and reads better at every call site
      than LOG.debug(...). Allowing it by name is clearer than suppressing the rule.
    -->
    <module name="ConstantName">
      <property name="format" value="^(log|[A-Z][A-Z0-9]*(_[A-Z0-9]+)*)$"/>
    </module>

    <!-- Design. -->
    <module name="VisibilityModifier">
      <property name="protectedAllowed" value="true"/>
    </module>
    <module name="FinalClass"/>
    <module name="HideUtilityClassConstructor"/>
    <module name="InterfaceIsType"/>
    <module name="MutableException"/>
    <module name="ModifierOrder"/>
    <module name="RedundantModifier"/>

    <!-- Size limits: a method past this length is doing more than one thing. -->
    <module name="MethodLength">
      <property name="max" value="80"/>
    </module>
    <module name="ParameterNumber">
      <property name="max" value="8"/>
    </module>

    <!-- Logging and output: System.out has no level, no context and no formatting. -->
    <module name="Regexp">
      <property name="format" value="System\.(out|err)\.print"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use SLF4J logging instead of System.out/System.err."/>
    </module>

    <!--
      Field injection makes dependencies invisible and objects impossible to construct in
      a plain unit test. Matches an @Autowired field declaration specifically: a field has
      no parentheses before its semicolon, so an @Autowired constructor is not flagged.
    -->
    <module name="Regexp">
      <property name="format" value="@Autowired\s+(?:(?:private|protected|public|final|static)\s+)*[\w.&lt;&gt;\[\]]+\s+\w+\s*;"/>
      <property name="illegalPattern" value="true"/>
      <property name="message" value="Use constructor injection, not field injection."/>
    </module>

    <!-- A TODO is fine in a tracker, not as the implementation of a shipped feature. -->
    <module name="TodoComment">
      <property name="format" value="(TODO)|(FIXME)|(XXX)"/>
    </module>

  </module>
</module>
